# ════════════════════════════════════════════════════════════════════════════
# PRODUCTION — NO TESTNET VARS ALLOWED
# Venue endpoints are hardcoded in core/config.py. These two variables are
# optional and only accepted if they match production exactly.
# ════════════════════════════════════════════════════════════════════════════
ARCUS_API_URL=https://api.arcus.xyz
ARCUS_WS_URL=wss://api.arcus.xyz/v1/ws

# ── Required credentials ──────────────────────────────────────────────────────
# Master Ethereum address that owns the Arcus account (Robinhood Chain).
L1_ADDRESS=0xYourWallet

# Subaccount index (0–9). Default 0.
ACCOUNT_INDEX=0

# Ed25519 API key PRIVATE key — 64 hex chars (no 0x). Used to sign orders.
# Generate + register with:  python bot.py fleet setup-key
API_PRIVATE_KEY=

# Ed25519 API key PUBLIC key — 64 hex chars. Optional reference only.
API_PUBLIC_KEY=

# ── Fleet config ──────────────────────────────────────────────────────────────
FLEET_ENABLED_GROUPS=crypto       # crypto | equities | commodities | indices | all
# Markets are OPT-IN: `fleet start` streams data but quotes NOTHING until you
# enable markets from the dashboard pills. Set true to auto-quote the group.
FLEET_QUOTE_ON_START=false
FLEET_ORDER_SIZE_USD=25
FLEET_SPREAD_BPS=0.15
FLEET_REQUOTE_BPS=0.25
FLEET_REFRESH_MS=12000
FLEET_MAX_CONCURRENT_MARKETS=20
FLEET_DAILY_LOSS_USD=100
FLEET_LEVERAGE=5
FLEET_QUOTE_RWA_OFF_HOURS=true    # Arcus RWA perps trade 24/7 including weekends

# Inventory management (profitability core)
FLEET_MAX_HOLD_S=300
FLEET_ADVERSE_STOP_BPS=10
FLEET_MARKET_LOSS_USD=10

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8900
