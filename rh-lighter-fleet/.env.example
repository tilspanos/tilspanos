# ════════════════════════════════════════════════════════════════════════════
# PRODUCTION — NO TESTNET VARS ALLOWED
# The venue endpoints are hardcoded in core/config.py. These three variables
# are optional and only accepted if they match production exactly.
# ════════════════════════════════════════════════════════════════════════════
LIGHTER_API_URL=https://api.rh.lighter.xyz/
LIGHTER_WS_URL=wss://api.rh.lighter.xyz/stream
LIGHTER_CHAIN_ID=466324

# ── Required credentials ──────────────────────────────────────────────────────
# Paste the values exactly as Lighter shows them when you create an API key.
L1_ADDRESS=0xYourWallet

# Account index — shown by Lighter next to your account.
# May also be left empty: it is auto-discovered from L1_ADDRESS.
ACCOUNT_INDEX=

# API key index — the index you picked when creating the key on Lighter.
# Anything from 4 to 254 works EXCEPT 157 (0-3 and 157 are reserved).
API_KEY_INDEX=5

# API key PRIVATE key — used for signing orders. Keep this secret.
API_PRIVATE_KEY=

# API key PUBLIC key — shown alongside the private key. Optional: the bot
# signs with the private key only, but you can keep it here for reference.
API_PUBLIC_KEY=

# ── Optional: multi-key fleet (recommended for 20+ markets) ──────────────────
# Each API key has its own nonce on the venue; markets are pinned to keys
# round-robin so parallel workers never contend on a nonce.
#API_KEY_INDEX_1=5
#API_PRIVATE_KEY_1=0x...
#API_KEY_INDEX_2=6
#API_PRIVATE_KEY_2=0x...
#API_KEY_INDEX_3=7
#API_PRIVATE_KEY_3=0x...

# ── Fleet config ──────────────────────────────────────────────────────────────
FLEET_ENABLED_GROUPS=crypto       # crypto | stocks | spot | memes | majors | all (comma-separated)
# Markets are OPT-IN: by default `fleet start` streams data but quotes NOTHING
# until you enable markets from the dashboard pills. Set true to auto-quote
# every market in the enabled groups on startup.
FLEET_QUOTE_ON_START=false
FLEET_ORDER_SIZE_USD=25
FLEET_SPREAD_BPS=0.15
FLEET_REQUOTE_BPS=0.02
FLEET_REFRESH_MS=12000
FLEET_MAX_CONCURRENT_MARKETS=20   # scale by available USDG margin
FLEET_DAILY_LOSS_USD=100          # halt + flatten if exceeded
FLEET_LEVERAGE=5

# Inventory management (profitability core)
FLEET_MAX_HOLD_S=120              # passive-exit patience before taker flatten
FLEET_ADVERSE_STOP_BPS=10         # taker flatten if position moves this far against us
FLEET_MARKET_LOSS_USD=10          # auto-disable a market after this realized loss

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8899
