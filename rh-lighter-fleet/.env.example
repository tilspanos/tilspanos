# ════════════════════════════════════════════════════════════════════════════
# PRODUCTION — NO TESTNET VARS ALLOWED
# The venue endpoints are hardcoded in core/config.py. These three variables
# are optional and only accepted if they match production exactly.
# ════════════════════════════════════════════════════════════════════════════
LIGHTER_API_URL=https://api.rh.lighter.xyz/
LIGHTER_WS_URL=wss://api.rh.lighter.xyz/stream
LIGHTER_CHAIN_ID=466324

# ── Required credentials ──────────────────────────────────────────────────────
L1_ADDRESS=0xYourWallet
ACCOUNT_INDEX=                    # leave empty: auto-discovered via accountsByL1Address
API_KEY_INDEX=4                   # use >=4, avoid reserved 0-3,157
API_PRIVATE_KEY=0xYourApiKeyPrivateKey

# ── Optional: multi-key fleet (recommended for 20+ markets) ──────────────────
# Each API key has its own nonce on the venue; markets are pinned to keys
# round-robin so parallel workers never contend on a nonce.
#API_KEY_INDEX_1=5
#API_PRIVATE_KEY_1=0x...
#API_KEY_INDEX_2=6
#API_PRIVATE_KEY_2=0x...
#API_KEY_INDEX_3=7
#API_PRIVATE_KEY_3=0x...

# ── Fleet config ──────────────────────────────────────────────────────────────
FLEET_ENABLED_GROUPS=crypto       # crypto | stocks | spot | memes | majors | all (comma-separated)
FLEET_ORDER_SIZE_USD=25
FLEET_SPREAD_BPS=0.15
FLEET_REQUOTE_BPS=0.02
FLEET_REFRESH_MS=12000
FLEET_MAX_CONCURRENT_MARKETS=20   # scale by available USDG margin
FLEET_DAILY_LOSS_USD=100          # halt + flatten if exceeded
FLEET_LEVERAGE=5

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8899
